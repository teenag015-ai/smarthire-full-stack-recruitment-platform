<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- React Frontend -->
		<SpaRoot>..\hiringprojectnew.client</SpaRoot>
		<SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
		<SpaProxyServerUrl>https://localhost:53027</SpaProxyServerUrl>
	</PropertyGroup>

	<ItemGroup>

		<!-- JWT Authentication -->
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />

		<!-- OpenAPI -->
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />

		<!-- React SPA Proxy -->
		<PackageReference Include="Microsoft.AspNetCore.SpaProxy">
			<Version>10.*-*</Version>
		</PackageReference>

		<!-- Entity Framework Core - SQL Server -->
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />

		<!-- Entity Framework Core Tools -->
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.12">

			<PrivateAssets>all</PrivateAssets>

			<IncludeAssets>
				runtime; build; native; contentfiles; analyzers; buildtransitive
			</IncludeAssets>

		</PackageReference>
		<PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />

	</ItemGroup>

	<ItemGroup>

		<!-- React Frontend Project -->
		<ProjectReference Include="..\hiringprojectnew.client\hiringprojectnew.client.esproj">

			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>

		</ProjectReference>

	</ItemGroup>

	<ItemGroup>

		<!-- Project Folders -->
		<Folder Include="Middleware\" />
		<Folder Include="wwwroot\uploads\resumes\" />

	</ItemGroup>

</Project>